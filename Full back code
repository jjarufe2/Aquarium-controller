void getData() {
  int packetSize = espLinkUDP.parsePacket();
  if (packetSize <= 0) {
    return;
  }

  if (packetSize != sizeof(dataReceived)) {
    Serial.print("WiFi packet rejected: received ");
    Serial.print(packetSize);
    Serial.print(", expected ");
    Serial.println(sizeof(dataReceived));

    while (espLinkUDP.available()) {
      espLinkUDP.read();
    }
    return;
  }

  dataReceived temporary = {};
  int count = espLinkUDP.read(reinterpret_cast<uint8_t*>(&temporary), sizeof(temporary));
  if (count != sizeof(temporary)) {
    Serial.println("WiFi command/data packet incomplete");
    return;
  }

  bool valid = true;

  if (temporary.header != PACKET_HEADER) {
    valid = false;
  }

  if (temporary.footer != PACKET_FOOTER) {
    Serial.print("invalid footer: 0x");
    Serial.println(temporary.footer, HEX);
    valid = false;
  }

  if (!isfinite(temporary.tankTemp) ||
      !isfinite(temporary.tankPh) ||
      !isfinite(temporary.tds) ||
      !isfinite(temporary.freshReservoirTemp) ||
      !isfinite(temporary.saltReservoirTemp) ||
      !isfinite(temporary.fillGallons) ||
      !isfinite(temporary.drainGallons)) {
    valid = false;
  }

  if (temporary.fillGallons < 0 || temporary.drainGallons < 0) {
    valid = false;
  }

  if ((temporary.floatStatusFresh != 0 && temporary.floatStatusFresh != 1) ||
      (temporary.floatStatusSalt != 0 && temporary.floatStatusSalt != 1)) {
    valid = false;
  }

  if (!valid) {
    Serial.println("WiFi data packet rejected");
    return;
  }

  receivedData = temporary;
  systemInfo.parameters[0] = temporary.tankTemp;
  systemInfo.parameters[2] = temporary.tankPh;
  systemInfo.parameters[5] = temporary.tds;
  systemInfo.parameters[1] = temporary.saltReservoirTemp;
  systemInfo.parameters[6] = temporary.freshReservoirTemp;
  systemInfo.drainGallons = temporary.drainGallons;
  systemInfo.fillGallons = temporary.fillGallons;
  systemInfo.floatStatusFresh = temporary.floatStatusFresh;
  systemInfo.floatStatusSalt = temporary.floatStatusSalt;
  systemInfo.parameters[3] = temporary.floatStatusSalt;
  systemInfo.parameters[4] = temporary.floatStatusFresh;

  Serial.print("WiFi fill gallons: ");
  Serial.println(temporary.fillGallons, 4);
  Serial.print("WiFi drain gallons: ");
  Serial.println(temporary.drainGallons, 4);

  doCommand();
}
