IPAddress getEspLinkBroadcastAddress() {
  IPAddress ip = WiFi.localIP();
  IPAddress mask = WiFi.subnetMask();

  return IPAddress(
    ip[0] | (uint8_t)(~mask[0]),
    ip[1] | (uint8_t)(~mask[1]),
    ip[2] | (uint8_t)(~mask[2]),
    ip[3] | (uint8_t)(~mask[3])
  );
}

void onWSEvent(WStype_t type, uint8_t* payload, size_t length) {
  switch (type) {
    case WStype_CONNECTED:
      Serial.println("Back ESP WebSocket connected");
      // Unique ID so it cannot replace the front ESP's cloud registration.
      wsClient.sendTXT("{\"action\":\"register\",\"clientId\":\"aquarium-back-esp32\"}");
      break;

    case WStype_DISCONNECTED:
      Serial.println("Back ESP WebSocket disconnected");
      break;

    case WStype_TEXT:
      Serial.printf("Back WS Message: %.*s\n", static_cast<int>(length), reinterpret_cast<char*>(payload));
      break;

    case WStype_ERROR:
      Serial.println("Back ESP WebSocket error");
      break;

    default:
      break;
  }
}

