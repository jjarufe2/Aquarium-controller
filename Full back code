  digitalWrite(transferpump,LOW);
  if(digitalRead(saltWaterLevel)==HIGH){
    digitalWrite(transferpump,HIGH);
    inTransfer=false;
    systemInfo.changeStatus = 6;
  systemInfo.waterChangeStatusArr[3] = 0;
  }
  if(systemInfo.floatStatusFresh==0){
    digitalWrite(transferpump,HIGH);
    inTransfer=false;
    systemInfo.changeStatus = 6;
   systemInfo.waterChangeStatusArr[3] = 0;
  }
  //stop if reservoir gets below float
  
}
void reservoirFilling(){
  if(digitalRead(freshWaterLevel)==HIGH && digitalRead(saltWaterLevel)==LOW && systemInfo.floatStatusFresh==1){
    inTransfer=true;
  }
  if(digitalRead(freshWaterLevel)==HIGH && digitalRead(saltWaterLevel)==HIGH){
    reservoirFillingInProgress=false;
    systemInfo.waterChangeStatusArr[4]=0;
    systemInfo.changeStatus=6;
     inTransfer=false;
    drawCurrentPage();
    drawHeaderWithPage();
  }

}
void draining(int requestedGallons){
  // The FRONT ESP owns the flow counter. Always use its latest value.
  drainGallons = systemInfo.drainGallons;

  if(drainGallons<requestedGallons){
    digitalWrite(solOut, LOW);
    if(millis()-delayInterval>2000){
      digitalWrite(pumpInsideOut, LOW);

      if (millis() - flowInterval >= 1000) {
        drawHeader("WATER CHANGE");
        flowInterval = millis();

        Serial.print("Drain gallons: ");
        Serial.println(drainGallons, 4);
      }
    }
  }

  if(drainGallons>=requestedGallons){
    digitalWrite(pumpInsideOut, HIGH);
    digitalWrite(solOut, HIGH);

    // Do not clear drainGallons here. waterChange() must see that
    // the requested drain amount was reached before it can start filling.
    inDrain=false;
    startTime=millis();
    delayInterval=millis();
    systemInfo.changeStatus=6;
    systemInfo.waterChangeStatusArr[2] = 0;

    // Standalone drain is completely finished, so clear the back ESP's copy.
    // During an automatic water change, keep the value so waterChange() can
    // see that the drain stage reached its target and advance to filling.
    if (!changeInProgress) {
      drainGallons = 0.0f;
      systemInfo.drainGallons = 0.0f;
    }
  }
}
void filling(int requestedGallons){
  // The FRONT ESP owns the flow counter. Always use its latest value.
  fillGallons = systemInfo.fillGallons;

  if(!(systemInfo.floatStatusSalt==0)){
    if(fillGallons<requestedGallons){
      digitalWrite(solIn, LOW);
      if(millis()-delayInterval>2000){
        digitalWrite(pumpOutsideIn, LOW);

        if (millis() - flowInterval >= 1000) {
          drawHeader("WATER CHANGE");
          flowInterval = millis();

          Serial.print("Fill gallons: ");
          Serial.println(fillGallons, 4);
        }
      }
    }

    if(fillGallons>=requestedGallons){
      digitalWrite(pumpOutsideIn, HIGH);
      digitalWrite(solIn, HIGH);

      // Do not clear fillGallons here. waterChange() must see that
      // the requested fill amount was reached before it can finish.
      inFill=false;
      systemInfo.changeStatus=6;
      startTime=millis();
      delayInterval=millis();
      systemInfo.waterChangeStatusArr[1] = 0;

      // Standalone fill is completely finished, so clear the back ESP's copy.
      // During an automatic water change, keep the value until waterChange()
      // sees that the fill stage reached its target and finishes the sequence.
      if (!changeInProgress) {
        fillGallons = 0.0f;
        systemInfo.fillGallons = 0.0f;
      }
    }
  }else{
    digitalWrite(pumpOutsideIn, HIGH);
    digitalWrite(solIn, HIGH);
    fillGallons=0.0f;
    systemInfo.fillGallons=0.0f;
    inFill=false;
    systemInfo.changeStatus=6;
    startTime=millis();
    delayInterval=millis();
    systemInfo.waterChangeStatusArr[1] = 0;
    changeInProgress = false;
  }
}
void waterChange() {
  drainGallons = systemInfo.drainGallons;
  fillGallons = systemInfo.fillGallons;

  systemInfo.requestedDrainGallons=10;
  systemInfo.requestedFillGallons=10;
  if(drainGallons<10){
    inDrain=true;
  }
  else if (drainGallons>=10 && inDrain==false&&fillGallons<10){
    inFill=true;
  }
  if(fillGallons>=10 && inFill==false){
    Serial.print("stopped change");
    drainGallons=0.0f;
    fillGallons=0.0f;
    systemInfo.drainGallons=0.0f;
    systemInfo.fillGallons=0.0f;
    changeInProgress=false;
    systemInfo.waterChangeStatusArr[0]=0;
    drawCurrentPage();
    drawWaterChangeScrollableArea();
    systemInfo.changeStatus = 6;
    drawHeaderWithPage();
  }

  }

