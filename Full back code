void sendStatusIfChanged(){
  bool changed = (systemInfo.changeStatus != lastSentChangeStatus);

  for(int i=0; i<waterChangeFunctions; i++){
    if(systemInfo.waterChangeStatusArr[i] != lastSentWaterChangeStatusArr[i]){
      changed = true;
      break;
    }
  }

  if(changed){
    sendData();
  }
}

