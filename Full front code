void displayStatus() {
  
  int receivedStatus = systemInfo.changeStatus;
  bool wasInFill = inFill;
  bool wasInDrain = inDrain;

  switch (receivedStatus) {
    case 2:  // draining
      if (!wasInDrain && !countDrainFlow) {
        resetDrainFlowCounter();
      }
      inDrain = true;
      inFill = false;
      reservoirFillingInProgress = false;
      inTransfer = false;
      countDrainFlow = true;
      countFillFlow = false;
      break;

    case 3:  // filling
      
      if (!wasInFill && !countFillFlow) {
        resetFillFlowCounter();
      }
      inDrain = false;
      inFill = true;
      reservoirFillingInProgress = false;
      inTransfer = false;
      countDrainFlow = false;
      countFillFlow = true;
      break;

    case 4:  // reservoir fill
      inDrain = false;
      inFill = false;
      reservoirFillingInProgress = true;
      inTransfer = false;
      countDrainFlow = false;
      countFillFlow = false;
      break;

    case 5:  // transfer
      inDrain = false;
      inFill = false;
      reservoirFillingInProgress = false;
      inTransfer = true;
      countDrainFlow = false;
      countFillFlow = false;
      break;

    case 6:  // stage/operation finished or stopped
      {
       
        bool automaticStageTransition =
          automaticWaterChangeCounting && systemInfo.waterChangeStatusArr[0] == 1;

        if (!automaticStageTransition) {
          if (automaticWaterChangeCounting) {
            // Entire automatic water change is finished/stopped.
            resetDrainFlowCounter();
            resetFillFlowCounter();
          } else {
           
            if (wasInDrain) {
              resetDrainFlowCounter();
            }
            if (wasInFill) {
              resetFillFlowCounter();
            }
          }
        }

        inDrain = false;
        inFill = false;
        reservoirFillingInProgress = false;
        inTransfer = false;
        countDrainFlow = false;
        countFillFlow = false;

        if (!automaticStageTransition) {
          automaticWaterChangeCounting = false;
          systemInfo.changeStatus = 0;
        }
        break;
      }

    case 0: 
      inDrain = false;
      inFill = false;
      reservoirFillingInProgress = false;
      inTransfer = false;
      countDrainFlow = false;
      countFillFlow = false;
      automaticWaterChangeCounting = false;
      break;

    default:
      return;
  }

 
  drawHeaderWithPage();
}

