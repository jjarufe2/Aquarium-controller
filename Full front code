void handleTouch() {
  uint16_t x;
  uint16_t y;

  bool fingerIsDown = tft.getTouch(&x, &y);

  if (fingerIsDown) {
    if (!fingerWasDown) {
      fingerWasDown = true;
      fingerMoved = false;

      touchStartX = x;
      touchStartY = y;

      lastTouchX = x;
      lastTouchY = y;
    } else {
      bool startedInsideScrollableArea = touchStartY >= headerHeight && touchStartY < screenHeight - footerHeight;

      

      if (startedInsideScrollableArea && currentPage == sensorsPage) {
        int movement = lastTouchY - y;

        if (abs(movement) >= SCROLL_THRESHOLD) {
          fingerMoved = true;

          scrollOffset += movement;

          scrollOffset = constrain(scrollOffset, 0, maximumScroll);

          lastTouchY = y;

          drawScrollableArea();
        }
      }

     

      else if (startedInsideScrollableArea && currentPage == devicePage) {
        /*for(int x=0;x<functionCount;x++){
        if (receivedData.statusArr[x]!=systemInfo.statusArr[x]){
        systemInfo.statusArr[x]=receivedData.statusArr[x];
       drawScrollableArea();*/


        int movement = lastTouchY - y;

        if (abs(movement) >= SCROLL_THRESHOLD) {
          fingerMoved = true;

          functionScrollOffset += movement;

          functionScrollOffset = constrain(functionScrollOffset, 0, functionMaximumScroll);

          lastTouchY = y;

          drawFunctionScrollableArea();
        }
      } else if (startedInsideScrollableArea && currentPage == mainGraphPage) {
        /*for(int x=0;x<functionCount;x++){
        if (receivedData.statusArr[x]!=systemInfo.statusArr[x]){
        systemInfo.statusArr[x]=receivedData.statusArr[x];
       drawScrollableArea();*/


        int movement = lastTouchY - y;

        if (abs(movement) >= SCROLL_THRESHOLD) {
          fingerMoved = true;

          graphScrollOffset += movement;

          graphScrollOffset = constrain(graphScrollOffset, 0, graphMaximumScroll);

          lastTouchY = y;

          drawMainGraphScrollableArea();
        }
      } else if (startedInsideScrollableArea && currentPage == waterChangePage) {
        /*for(int x=0;x<functionCount;x++){
        if (receivedData.statusArr[x]!=systemInfo.statusArr[x]){
        systemInfo.statusArr[x]=receivedData.statusArr[x];
       drawScrollableArea();*/


        int movement = lastTouchY - y;

        if (abs(movement) >= SCROLL_THRESHOLD) {
          fingerMoved = true;

          waterChangeScrollOffset += movement;

          waterChangeScrollOffset = constrain(waterChangeScrollOffset, 0, waterChangeMaximumScroll);

          lastTouchY = y;

          drawWaterChangeScrollableArea();
        }
      }
      /*else if(startedInsideScrollableArea &&currentPage == mainFunctionPage){
        drawMainFunctionPage();
      }
      */
    }
  }

  
  else if (fingerWasDown) {
    fingerWasDown = false;

    if (fingerMoved) {
     
      scrollStoppedTime = millis();
    } else {
      
      if (millis() - scrollStoppedTime >= TOUCH_WAIT_AFTER_SCROLL) {
        handleTap(touchStartX, touchStartY);
      }
    }
  }
}



void handleTap(uint16_t x, uint16_t y) {
  // Footer navigation
  if (y >= screenHeight - footerHeight) {
    checkFooterTouch(x);
    return;
  }

  if (currentPage == homePage) {
    checkHomeTouch(x, y);
  }

  else if (currentPage == mainFunctionPage) {
    //checkFunctionTouch(x, y);
    checkMainFunctionPageTouch(x, y);
  } else if (currentPage == devicePage) {
    checkFunctionTouch(x, y);
  } else if (currentPage == mainGraphPage) {
    checkMainGraphPageTouch(x, y);
  } else if (currentPage == waterChangePage) {
    checkWaterChangePageTouch(x, y);
  } else if (currentPage == waterChangePopUp) {
    checkWaterChangePopUpTouch(x, y);
  } else if (currentPage == fillPopUp) {
    checkFillPopUpTouch(x, y);
  } else if (currentPage == drainPopUp) {
    checkDrainPopUpTouch(x, y);
  } else if (currentPage == transferPopUp) {
    checkTransferPopUpTouch(x, y);
  } else if (currentPage == reservoirFillpopUp) {
    checkReservoirFillPopUpTouch(x, y);
  }
}

void checkFooterTouch(uint16_t x) {
  int sectionWidth = screenWidth / 4;

  int selectedSection = x / sectionWidth;

  if (selectedSection == 0) {
    currentPage = homePage;
  } else if (selectedSection == 1) {
    currentPage = sensorsPage;
  } else if (selectedSection == 2) {
    currentPage = mainFunctionPage;
  } else if (selectedSection == 3) {
    currentPage = mainGraphPage;
  }

  drawCurrentPage();
}

void checkHomeTouch(uint16_t x, uint16_t y) {
  int availableHeight = screenHeight - headerHeight - footerHeight;

  int buttonGap = 8;
  int outerMargin = 10;

  int buttonWidth = (screenWidth - outerMargin * 2 - buttonGap * 2) / 3;

  int buttonHeight = 90;

  int buttonY = headerHeight + (availableHeight - buttonHeight) / 2;

  int sensorX = outerMargin;

  int functionX = outerMargin + buttonWidth + buttonGap;

  int dataX = outerMargin + (buttonWidth + buttonGap) * 2;

  if (pointInside(x, y, sensorX, buttonY, buttonWidth, buttonHeight)) {
    currentPage = sensorsPage;
    drawCurrentPage();
  }

  else if (pointInside(x, y, functionX, buttonY, buttonWidth, buttonHeight)) {
    currentPage = mainFunctionPage;
    //currentPage = devicePage;
    drawCurrentPage();
  }

  else if (pointInside(x, y, dataX, buttonY, buttonWidth, buttonHeight)) {
    currentPage = mainGraphPage;
    drawCurrentPage();
  }
}


void checkFunctionTouch(uint16_t x, uint16_t y) {
  int listTop = headerHeight;

  int listBottom = screenHeight - footerHeight;

  if (y < listTop || y >= listBottom) {
    return;
  }
  int toggleLeft = screenWidth - 70;
  int toggleRight = screenWidth - 10;

  if (x < toggleLeft || x > toggleRight) {
    return;
  }


  int contentY = y - listTop + functionScrollOffset;

  int rowSpace = FUNCTION_rowHeight + FUNCTION_rowGap;

  int selectedFunction = contentY / rowSpace;

  int positionInsideRow = contentY % rowSpace;

  if (selectedFunction < 0 || selectedFunction >= functionCount || positionInsideRow >= FUNCTION_rowHeight) {
    return;
  }
  for (int x = 0; x < 8; x++) {
    temporaryStatusArr[x] = systemInfo.statusArr[x];
  }

  systemInfo.statusArr[selectedFunction] = 2;
  sendCommandArray(selectedFunction);
  //sendData();

  Serial.print("Selected function: ");
  Serial.println(systemInfo.functionNames[selectedFunction]);

  Serial.print("New state: ");

  if (systemInfo.statusArr[selectedFunction] == 1) {
    Serial.println("ON");
  } else {
    Serial.println("OFF");
  }



  drawFunctionScrollableArea();
}


bool pointInside(int touchX, int touchY, int rectangleX, int rectangleY, int rectangleWidth, int rectangleHeight) {
  return (touchX >= rectangleX && touchX <= rectangleX + rectangleWidth && touchY >= rectangleY && touchY <= rectangleY + rectangleHeight);
}
