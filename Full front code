IPAddress getEspLinkBroadcastAddress() {
  IPAddress ip = WiFi.localIP();
  IPAddress mask = WiFi.subnetMask();

  return IPAddress(
    ip[0] | (uint8_t)(~mask[0]),
    ip[1] | (uint8_t)(~mask[1]),
    ip[2] | (uint8_t)(~mask[2]),
    ip[3] | (uint8_t)(~mask[3])
  );
}
void IRAM_ATTR flowMeterIn() {
  unsigned long now = micros();

  if (now - lastFlowPulseIn >= MIN_FLOW_PULSE_US) {
    pulseCount1++;
    lastFlowPulseIn = now;
  }
}

void IRAM_ATTR flowMeterOut() {
  unsigned long now = micros();

  if (now - lastFlowPulseOut >= MIN_FLOW_PULSE_US) {
    pulseCount2++;
    lastFlowPulseOut = now;
  }
}

