float readTds() {
  if (millis() - tdsReadingInterval > 40) {
    tdsReadingInterval = millis();
    //int raw = fillPhArray();
    int millivolts = fillTdsArray();
    //Serial.print("tds adc");
   // Serial.print(millivolts);
   // Serial.print("\n");
    //phSum += raw;
    tdsSum += millivolts;
    //readingsArr[phReadings]=raw;
    tdsReadingsArr[tdsReadings] = millivolts;
    tdsReadings++;
  }


  if (tdsReadings >= 40) {
    int minValue = tdsReadingsArr[0];
    int maxValue = tdsReadingsArr[0];
    for (int x = 0; x < 40; x++) {

      maxValue = maxValue > tdsReadingsArr[x] ? maxValue : tdsReadingsArr[x];
      minValue = minValue < tdsReadingsArr[x] ? minValue : tdsReadingsArr[x];
    }
    tdsSum -= (maxValue + minValue);
    float average = tdsSum / 38.0;
    //float voltage =average*(3.3/4095.0);
    float voltage = average / 1000.0;
    float tempF = systemInfo.parameters[6];
    if (!isfinite(tempF) || tempF < 40.0 || tempF > 100.0) {
      tempF = 77.0;
    }
    float tempC = (tempF - 32.0) * 5.0 / 9.0;

    float compensationCoefficient = 1.0 + 0.02 * (tempC - 25.0);
    //float compensationCoefficient=1.0+0.02*(systemInfo.parameters[6]-25.0);
    float compensatedVoltage = voltage / compensationCoefficient;
    float tds = (133.42 * pow(compensatedVoltage, 3) - 255.86 * pow(compensatedVoltage, 2) + 857.39 * compensatedVoltage) * 0.5;
    tdsReadings = 0;
    tdsSum = 0;
    for (int reset = 0; reset < 40; reset++) {
      tdsReadingsArr[reset] = 0;
    }
    //Serial.print("Ph is: ");
    //Serial.print(ph);
    //systemInfo.parameters[6]=getFreshWaterTemp();
    return tds;
  }
  return 0;
}

float readPh() {






  if (millis() - phReadingInterval > 40) {
    phReadingInterval = millis();
    //int raw = fillPhArray();
    int millivolts = fillPhArray();
    systemInfo.parameters[7] = millivolts;
   // Serial.print("pH voltage: ");
    //Serial.print(millivolts);
    //Serial.println(" mV");
    //phSum += raw;
    phSum += millivolts;
    //readingsArr[phReadings]=raw;
    readingsArr[phReadings] = millivolts;
    phReadings++;
  }


  if (phReadings >= 40) {
    int minValue = readingsArr[0];
    int maxValue = readingsArr[0];
    for (int x = 0; x < 40; x++) {

      maxValue = maxValue > readingsArr[x] ? maxValue : readingsArr[x];
      minValue = minValue < readingsArr[x] ? minValue : readingsArr[x];
    }
    phSum -= (maxValue + minValue);
    float average = phSum / 38.0;
    //float voltage =average*(3.3/4095.0);
    float voltage = average / 1000.0;


    float ph = 4.0 + (average - 1066.0) * (3.0 / 398.0);

    phReadings = 0;
    phSum = 0;
    for (int reset = 0; reset < 40; reset++) {
      readingsArr[reset] = 0;
    }
    //Serial.print("Ph is: ");
    //Serial.print(ph);

    return ph;
  }
  return 0;
}
