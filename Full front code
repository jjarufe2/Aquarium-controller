  getFlowData();

  wsClient.loop();
  handleTouch();
  if ((ph = readPh()) > 0) {
    systemInfo.parameters[2] = ph;
  }
  float tds = readTds();
  if (tds > 0) {
    systemInfo.parameters[5] = tds;
  }
  if (millis() - dataInterval > 1000) {
    dataInterval = millis();

