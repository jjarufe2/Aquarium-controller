    for (int y = 0; y < 12; y++) {
      tankTempData[y] = 0;
      saltReservoirTempData[y] = 0;
      phData[y] = 0;
      tdsData[y] = 0;
      freshReservoirData[y] = 0;
    }
  }
}
void getData() {
  int packetSize = espLinkUDP.parsePacket();
  if (packetSize <= 0) {
    return;
  }

 
  if (packetSize != sizeof(dataRecieved)) {
    Serial.print("WiFi packet rejected: received ");
    Serial.print(packetSize);
    Serial.print(", expected ");
    Serial.println(sizeof(dataRecieved));

  
    while (espLinkUDP.available()) {
      espLinkUDP.read();
    }
    return;
  }

  dataRecieved temporary = {};
  int count = espLinkUDP.read(reinterpret_cast<uint8_t*>(&temporary), sizeof(temporary));
  if (count != sizeof(temporary)) {
    Serial.println("WiFi status packet incomplete");
    return;
  }

  bool valid = true;

  if (temporary.header != PACKET_HEADER) {
    valid = false;
  }

  if (temporary.footer != PACKET_FOOTER) {
    Serial.print("invalid footer: 0x");
    Serial.println(temporary.footer, HEX);
    valid = false;
  }

  if (temporary.changeStatus < 0 || temporary.changeStatus > 6) {
    valid = false;
  }

  for (int i = 0; i < waterChangeFunctions; i++) {
    if (temporary.waterChangeStatusArr[i] != 0 && temporary.waterChangeStatusArr[i] != 1) {
      valid = false;
    }
  }

  for (int i = 0; i < functionCount; i++) {
    if (temporary.statusArr[i] != 0 && temporary.statusArr[i] != 1) {
      valid = false;
    }
  }

  if (!valid) {
    Serial.println("WiFi status packet rejected");
    return;
  }

  receivedData = temporary;
  systemInfo.changeStatus = temporary.changeStatus;

  bool waterChangeStatusChanged = false;
  for (int a = 0; a < waterChangeFunctions; a++) {
    if (systemInfo.waterChangeStatusArr[a] != temporary.waterChangeStatusArr[a]) {
      systemInfo.waterChangeStatusArr[a] = temporary.waterChangeStatusArr[a];
      waterChangeStatusChanged = true;
    }
  }

  if (waterChangeStatusChanged && currentPage == waterChangePage) {
    drawWaterChangeScrollableArea();
  }

  displayStatus();

  bool statusChanged = false;
  for (int y = 0; y < functionCount; y++) {
    if (systemInfo.statusArr[y] != temporary.statusArr[y]) {
      systemInfo.statusArr[y] = temporary.statusArr[y];
      temporaryStatusArr[y] = temporary.statusArr[y];
      statusChanged = true;
    }
  }

  if (statusChanged && currentPage == devicePage) {
    drawFunctionScrollableArea();
  }
}
void getFlowData() {
  if (millis() - flowIntervalFill >= 1000) {
    noInterrupts();
    fillPulses = pulseCount1;
    pulseCount1 = 0;
    interrupts();

    flowIntervalFill = millis();

    if (countFillFlow) {
      gallonsIn += (fillPulses / 7.5 / 60.0) * 0.264172;
    }
    systemInfo.fillGallons = gallonsIn;

    Serial.print("fill gallons: ");
    Serial.println(gallonsIn, 4);
  }
  if (millis() - flowIntervalDrain >= 1000) {
    noInterrupts();
    drainPulses = pulseCount2;
    pulseCount2 = 0;
    interrupts();

    flowIntervalDrain = millis();

    if (countDrainFlow) {
      gallonsOut += (drainPulses / 7.5 / 60.0) * 0.264172;
    }
    systemInfo.drainGallons = gallonsOut;

    Serial.print("Drain gallons: ");
    Serial.println(gallonsOut, 4);
  }
}
