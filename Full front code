  tft.setTouch(calibrationData);
  wifiMulti.addAP(WIFI_SSID, WIFI_PASSWORD);
  while (wifiMulti.run() != WL_CONNECTED) {
    delay(100);
  }

  Serial.println("Connected");
  
  wsClient.beginSSL(WS_HOST, WS_PORT, WS_URL);
  wsClient.onEvent(onWSEvent);
  wsClient.setReconnectInterval(5000);
  wsClient.enableHeartbeat(15000, 3000, 2);

  sensors.begin();

  espLinkUDP.begin(FRONT_RX_PORT);
  Serial.print("Front ESP UDP listening on port ");
  Serial.println(FRONT_RX_PORT);
  pinMode(BACKLIGHT_PIN, OUTPUT);
  pinMode(floatSwitchFresh, INPUT_PULLUP);
  pinMode(floatSwitchSalt, INPUT_PULLUP);
  pinMode(tdsMeter, INPUT);
  analogSetPinAttenuation(tdsMeter, ADC_11db);
  pinMode(flowPinIn, INPUT_PULLUP);
  pinMode(flowPinOut, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(flowPinIn), flowMeterIn, FALLING);
  attachInterrupt(digitalPinToInterrupt(flowPinOut), flowMeterOut, FALLING);



  digitalWrite(BACKLIGHT_PIN, HIGH);  // USB Serial Monitor


  screenWidth = tft.width();
  screenHeight = tft.height();

  calculateMaximumScroll();
  calculateFunctionMaximumScroll();
  calculateWaterChangeMaximumScroll();
  calculateGraphMaximumScroll();

  drawCurrentPage();

  
}

void sleepScreen() {
  if (screenSleeping) {
    return;
  }

  digitalWrite(BACKLIGHT_PIN, LOW);
  screenSleeping = true;
}
void wakeScreen() {
  if (!screenSleeping) {
    return;
  }

  digitalWrite(BACKLIGHT_PIN, HIGH);
  delay(20);

  drawCurrentPage();  // Draw the image again

  screenSleeping = false;
  lastTouchTime = millis();
}
void checkTouch() {
  uint16_t x, y;

  bool touched = tft.getTouch(&x, &y);

  if (touched) {
    if (screenSleeping) {
      wakeScreen();
      delay(200);
      return;
    }

    lastTouchTime = millis();

    
  }
}
void getGraphData() {
  if (!(dataIndex == 12)) {
    tankTempData[dataIndex] = systemInfo.parameters[0];
    saltReservoirTempData[dataIndex] = systemInfo.parameters[1];
    phData[dataIndex] = systemInfo.parameters[2];
    tdsData[dataIndex] = systemInfo.parameters[5];
    freshReservoirData[dataIndex] = systemInfo.parameters[6];
    dataIndex++;
  } else {
